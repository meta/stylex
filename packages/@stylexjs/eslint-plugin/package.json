{
  "name": "@stylexjs/eslint-plugin",
  "version": "0.19.2",
  "description": "StyleX eslint plugin.",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meta/stylex.git",
    "directory": "packages/@stylexjs/eslint-plugin"
  },
  "license": "MIT",
  "scripts": {
    "prebuild": "gen-types -i src/ -o lib/",
    "build": "babel src/ --out-dir lib/",
    "prebuild-haste": "gen-types -i src/ -o lib/",
    "build-haste": "rollup --config ./rollup.config.mjs",
    "test": "jest --detectOpenHandles --coverage && npm run test:oxlint",
    "test:oxlint": "node --test scripts/test-oxlint.mjs"
  },
  "peerDependencies": {
    "eslint": "^8.40.0 || ^9.0.0 || ^10.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "dependencies": {
    "@csstools/css-tokenizer": "^3.0.3",
    "@stylexjs/shared": "0.19.2",
    "micromatch": "^4.0.5",
    "postcss-value-parser": "^4.2.0"
  },
  "files": [
    "flow_modules/*",
    "lib/*"
  ]
}
